<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>SetuGateway</PackageId>
    <Version>0.1.0</Version>
    <Authors>Setu Gateway Contributors</Authors>
    <Description>Official C# client for Setu Gateway</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/setu-gateway/nexus-gateway</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <!-- SDK-style projects implicitly glob **/*.cs, which would otherwise also pull
       in tests/ (a nested test project referencing xUnit, which this library
       doesn't depend on) and fail the build with "type or namespace 'Xunit' could
       not be found" - excluding it here is the standard fix for a nested test
       project directory. -->
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>

</Project>
