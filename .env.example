# Server Environment Configuration
SERVICE_NAME=gateway
ENVIRONMENT=development
PORT=8000
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=postgresql://setu:setu_pass@localhost:5432/setu_db
# Max concurrent DB connections this gateway instance will hold is DB_POOL_SIZE +
# DB_MAX_OVERFLOW - raise these if you're running high request concurrency and see
# "QueuePool limit ... connection timed out" in the logs (each in-flight request holds
# one connection for its full duration). Stay within Postgres's own max_connections
# across all gateway replicas combined.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT_SECONDS=30

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20

# JWT & Security Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Provider API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Ollama points at a local (or remote) Ollama server - not an API key
OLLAMA_BASE_URL=http://localhost:11434
